# ------------------------------------------------------------------------------
# Base Containers – Registry Configuration
# ------------------------------------------------------------------------------
# Copy to .env and fill in values as needed.
# This file is SAFE to commit.
# ------------------------------------------------------------------------------

# Container registry host
# Examples:
#   registry.gitlab.com
#   ghcr.io
#   docker.io
#   quay.io
BASE_CONTAINERS_REGISTRY=registry.example.com

# Registry namespace / org / group path (no trailing slash)
# Examples:
#   myorg
#   myorg/myteam
#   company/platform/containers
BASE_CONTAINERS_NAMESPACE=example/org/path

# Project / repository name
BASE_CONTAINERS_PROJECT=base-containers

# ------------------------------------------------------------------------------
# Registry login (OPTIONAL, generic)
# ------------------------------------------------------------------------------
# These variables are NOT consumed by Make directly.
# They exist to standardize docker login across registries.
#
# Example usage:
#   echo "$REGISTRY_TOKEN" | docker login "$BASE_CONTAINERS_REGISTRY" \
#     -u "$REGISTRY_USER" --password-stdin
# ------------------------------------------------------------------------------

# Registry username (or service account name)
REGISTRY_USER=example-user

# Registry access token / password
# Must have permission to push images
REGISTRY_TOKEN=example-token

# ------------------------------------------------------------------------------
# Optional build overrides
# ------------------------------------------------------------------------------

# Target platforms for multi-arch builds
BASE_CONTAINERS_PLATFORMS=linux/amd64,linux/arm64

# Explicit tag override (defaults to VERSION)
# BASE_CONTAINERS_TAG=dev

# Explicit latest tag override
# BASE_CONTAINERS_TAG_LATEST=latest
